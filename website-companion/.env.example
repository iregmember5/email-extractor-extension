# Public Google OAuth client ID used by your Powerly website. Never add a client secret.
VITE_REACT_APP_GOOGLE_CLIENT_ID=your-public-client-id.apps.googleusercontent.com
# Comma-separated approved Chrome extension IDs from chrome://extensions.
VITE_POWERLY_EXTENSION_IDS=your-chrome-extension-id
VITE_API_URL=https://mypowerly.com/v1
